generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example User table to get started
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String?
  gender       String?
  phone        String?
  isActive     Boolean  @default(true)
  role         String   @default("student") // Could be admin, staff, student
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      Int?
  userRole    String?
  action      String
  
  targetAppId String?  // e.g., APP-2026-2759
  targetDoc   String?
  
  ipAddress   String?
  userAgent   String?
  deviceType  String?  // smartphone, tablet, desktop
  os          String?  // iOS, Android, Windows, macOS
  duration    Int?
  notes       String?  @db.Text
  
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Application {
  id                Int      @id @default(autoincrement())
  referenceNumber   String   @unique
  studentId         String
  lastName          String
  givenName         String
  middleName        String?
  college           String
  course            String
  status            String   @default("Pending")
  remarks           String?
  
  // Grouped JSON data to easily store the remaining 70+ fields
  personalInfo      Json     
  addressInfo       Json
  householdInfo     Json
  parentGuardianInfo Json
  householdMembers  Json     
  academicInfo      Json
  specialCircumstances Json
  verifiedDocuments Json?    @default("[]")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ph_regions {
  code              String @id
  name              String
  region_name       String
  island_group_code String
}

model ph_provinces {
  code        String @id
  name        String
  region_code String
}

model ph_cities {
  code          String @id
  name          String
  region_code   String
  province_code String?
}

model ph_barangays {
  code          String @id
  name          String
  region_code   String
  province_code String?
  city_code     String?
}
