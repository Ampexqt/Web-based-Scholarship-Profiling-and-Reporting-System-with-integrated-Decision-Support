generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example User table to get started
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("student") // Could be admin, staff, student
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id                Int      @id @default(autoincrement())
  referenceNumber   String   @unique
  studentId         String
  lastName          String
  givenName         String
  middleName        String?
  college           String
  course            String
  status            String   @default("Pending")
  
  // Grouped JSON data to easily store the remaining 70+ fields
  personalInfo      Json     
  addressInfo       Json
  householdInfo     Json
  parentGuardianInfo Json
  householdMembers  Json     
  academicInfo      Json
  specialCircumstances Json

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ph_regions {
  code              String @id
  name              String
  region_name       String
  island_group_code String
}

model ph_provinces {
  code        String @id
  name        String
  region_code String
}

model ph_cities {
  code          String @id
  name          String
  region_code   String
  province_code String?
}

model ph_barangays {
  code          String @id
  name          String
  region_code   String
  province_code String?
  city_code     String?
}
